{
  "openapi": "3.0.3",
  "info": {
    "title": "MT5 Manager REST API",
    "description": "Flask-based REST API for MetaTrader 5 Manager operations using the mt5manager Python package. Supports JWT authentication, positions, trading, plugins, and group/commission configuration (including per-commission overrides).",
    "version": "1.1.0",
    "contact": {
      "name": "Developer",
      "email": "synamatics@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:14315",
      "description": "Local development server (default port from API_PORT or 14315)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token obtained from POST /auth/login"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "login": { "type": "integer" },
          "name": { "type": "string" },
          "group": { "type": "string" },
          "balance": { "type": "number" },
          "credit": { "type": "number" },
          "leverage": { "type": "integer" },
          "company": { "type": "string" },
          "country": { "type": "string" },
          "email": { "type": "string" },
          "currency": { "type": "string" }
        },
        "required": ["login", "name", "group", "balance", "credit", "leverage"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "login": { "type": "integer", "description": "Manager account number" },
          "password": { "type": "string" },
          "server": { "type": "string", "description": "MT5 server address (optional, falls back to MT5_SERVER env)" }
        },
        "required": ["login", "password"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "example": "bearer" },
          "expires_in": { "type": "integer", "description": "Seconds until expiration" },
          "user_info": { "$ref": "#/components/schemas/UserInfo" }
        },
        "required": ["access_token", "token_type", "expires_in", "user_info"]
      },
      "Position": {
        "type": "object",
        "properties": {
          "ticket": { "type": "integer" },
          "symbol": { "type": "string" },
          "type": { "type": "integer", "description": "0 = BUY, 1 = SELL" },
          "volume": { "type": "number" },
          "price_open": { "type": "number" },
          "price_current": { "type": "number" },
          "profit": { "type": "number" }
        }
      },
      "TradeRequest": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "volume": { "type": "number" },
          "user_login": { "type": "integer", "description": "Target trader account" },
          "type": { "type": "string", "enum": ["BUY", "SELL"] },
          "price": { "type": "number" },
          "sl": { "type": "number" },
          "tp": { "type": "number" },
          "comment": { "type": "string" }
        },
        "required": ["symbol", "volume", "user_login", "type"]
      },
      "TradeResponse": {
        "type": "object",
        "properties": {
          "order": { "type": "integer" },
          "deal": { "type": "integer" },
          "result": { "type": "string" }
        }
      },
      "CommissionTier": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mode": { "type": "string" },
          "type": { "type": "string" },
          "value": { "type": "number" },
          "minimal": { "type": "number" },
          "maximal": { "type": "number" },
          "range_from": { "type": "number" },
          "range_to": { "type": "number" },
          "currency": { "type": "string" }
        }
      },
      "Commission": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Commission name (e.g. MAIN, comm_USD_Cad)" },
          "description": { "type": "string" },
          "mode": { "type": "string" },
          "range": { "type": "string" },
          "profit_mode": { "type": "string" },
          "total_tiers": { "type": "integer" },
          "tiers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CommissionTier" }
          },
          "has_config": { "type": "boolean", "description": "True if a [group|name] or group section exists in commissions.ini for this commission" },
          "split": { "type": "string", "description": "e.g. 70/20/10 (only present when has_config=true)" },
          "type": { "type": "string", "enum": ["percentage", "amount"], "description": "Only present when has_config=true" }
        },
        "required": ["name", "tiers"]
      },
      "Group": {
        "type": "object",
        "properties": {
          "group": { "type": "string", "description": "Full group path e.g. managers\\admin or demo\\forex-net-usd-01" },
          "company": { "type": "string" },
          "currency": { "type": "string" },
          "leverage": { "type": "integer" },
          "margin_call": { "type": "number" },
          "margin_stopout": { "type": "number" },
          "has_config": { "type": "boolean", "description": "True if group-level section exists in commissions.ini" },
          "split": { "type": "string", "description": "Group-level split (present only if has_config)" },
          "type": { "type": "string", "enum": ["percentage", "amount"] },
          "commissions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Commission" },
            "description": "List of commissions defined in MT5 for this group. Each now includes its own has_config/split/type when a [group|commission_name] section exists."
          }
        },
        "required": ["group"]
      },
      "GroupsTreeResponse": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "object",
            "description": "Nested tree structure. Keys are path segments split by backslash. Leaf nodes contain _data with Group object."
          },
          "total": { "type": "integer" }
        }
      },
      "Plugin": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "module": { "type": "string" },
          "status": { "type": "integer" },
          "version": { "type": "string" },
          "type": { "type": "integer" },
          "flags": { "type": "integer" },
          "build": { "type": "integer" },
          "company": { "type": "string" },
          "copyright": { "type": "string" },
          "description": { "type": "string" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      },
      "PluginsResponse": {
        "type": "object",
        "properties": {
          "plugins": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Plugin" }
          },
          "total": { "type": "integer" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "healthy" },
          "service": { "type": "string", "example": "mt5-api" }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login and obtain JWT token",
        "description": "Authenticates with MT5 Manager and returns a bearer token valid for ACCESS_TOKEN_EXPIRE_MINUTES (default 60).",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "login": 0,
                "password": "manager_password",
                "server": "MetaTrader5-ServerName"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "401": {
            "description": "Invalid credentials or IP not allowed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current authenticated manager info",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserInfo" } }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check (no authentication required)",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/positions": {
      "get": {
        "summary": "Get all open positions on the server",
        "tags": ["Trading"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of positions",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Position" } }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "Error retrieving positions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/trade": {
      "post": {
        "summary": "Place a trade for a specific trader account",
        "tags": ["Trading"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TradeRequest" },
              "example": {
                "symbol": "EURUSD",
                "volume": 0.1,
                "user_login": 123456,
                "type": "BUY",
                "price": 1.085,
                "sl": 1.08,
                "tp": 1.09,
                "comment": "Manual trade"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trade executed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TradeResponse" } } }
          },
          "400": {
            "description": "Trade failed or validation error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/account": {
      "get": {
        "summary": "Get detailed account information for the authenticated manager",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Account info",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInfo" } } }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Account not found" }
        }
      }
    },
    "/v1/plugins": {
      "get": {
        "summary": "List all installed plugins on the MT5 server",
        "tags": ["Plugins"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of plugins",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginsResponse" } } }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/plugins/{plugin_name}": {
      "get": {
        "summary": "Get details of a specific plugin by name (case-insensitive)",
        "tags": ["Plugins"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "plugin_name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "FeedRedundancy"
          }
        ],
        "responses": {
          "200": {
            "description": "Plugin details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Plugin" } } }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Plugin not found" }
        }
      }
    },
    "/v1/groups": {
      "get": {
        "summary": "List all groups with commissions config (lightweight tree view)",
        "description": "Returns a nested tree based on backslash group paths. Each leaf's _data contains basic Group fields (commissions array is omitted in this lightweight view for performance). Use GET /v1/group for full details including commissions with per-commission config.",
        "tags": ["Groups & Commissions"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Groups tree",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupsTreeResponse" } } }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/group": {
      "get": {
        "summary": "Get full details of a specific group including all commissions with their per-commission config",
        "description": "Returns a single Group object. Each item in the commissions array now includes has_config, split, and type when a corresponding [group|commission_name] section exists in commissions.ini. This enables the per-commission configuration feature.",
        "tags": ["Groups & Commissions"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Group name (case-insensitive), e.g. managers\\admin or demo\\forex-net-usd-01",
            "example": "demo\\forex-net-usd-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Group with commissions (per-commission config included)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Group" },
                "example": {
                  "group": "demo\\forex-net-usd-01",
                  "company": "MyBroker",
                  "currency": "USD",
                  "leverage": 0,
                  "has_config": true,
                  "split": "60/30/10",
                  "type": "percentage",
                  "commissions": [
                    {
                      "name": "MAIN",
                      "has_config": true,
                      "split": "80/10/10",
                      "type": "percentage",
                      "total_tiers": 1,
                      "tiers": [ { "value": 5.0 } ]
                    },
                    {
                      "name": "comm_USD_Cad",
                      "has_config": true,
                      "split": "70/20/10",
                      "type": "percentage",
                      "total_tiers": 3,
                      "tiers": [ { "value": 2.5 } ]
                    }
                  ]
                }
              }
            }
          },
          "400": { "description": "Group name required" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Group not found" }
        }
      },
      "put": {
        "summary": "Update commissions split/type for a group or a specific commission inside the group",
        "description": "Stores configuration in commissions.ini.\n\n- Without ?commission: updates the [group_name] section (group-level default).\n- With ?commission=xxx: updates the [group_name|xxx] section (per-commission override).\n\nThe UI can now select individual commissions (e.g. MAIN, comm_USD_Cad) inside a group and apply the same split/type logic previously available only at group level.\n\nAmount splits must match one of the tier values for the targeted commission(s).",
        "tags": ["Groups & Commissions"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Group name (case-insensitive)"
          },
          {
            "name": "commission",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Commission name (case-insensitive). When provided, the section written is \"name|commission\" instead of just \"name\".",
            "example": "MAIN"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "split": {
                    "type": "string",
                    "description": "Delimited by /",
                    "example": "70/20/10"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["percentage", "amount"],
                    "description": "percentage or amount"
                  }
                },
                "required": ["split", "type"]
              },
              "example": {
                "split": "70/20/10",
                "type": "percentage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Config updated successfully",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "message": { "type": "string" } } }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "422": {
            "description": "Validation failed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Authentication", "description": "Login and current user" },
    { "name": "System", "description": "Health and system endpoints" },
    { "name": "Trading", "description": "Positions and order execution" },
    { "name": "Plugins", "description": "MT5 plugin management" },
    { "name": "Groups & Commissions", "description": "Group listing and per-group / per-commission commission split configuration stored in commissions.ini" }
  ]
}
